# Docker Compose 环境变量样例
# 将本文件复制为 docker/.env 后按需修改
#
# cp docker/.env.example docker/.env
#
# 注意：.env 已被 .gitignore 排除，不要提交真实凭证

# 宿主机 MySQL 凭证（容器内通过 host.docker.internal 访问宿主机）
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# 端口映射（宿主机端口）
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring Boot profiles
SPRING_PROFILES_ACTIVE=dev,mysql

# 前端 API 基础路径（浏览器视角）
VITE_API_BASE_URL=http://localhost:8080/api
